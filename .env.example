SERVER_PORT=3000
DATABASE_URL=mongodb://localhost:27017/devameet
# Obrigatória, com pelo menos 32 caracteres. Gere com: openssl rand -hex 32
USER_JWT_SECRET_KEY=
# Só é necessária se o banco ainda tiver senhas no formato antigo (AES).
# Elas são convertidas para argon2 no primeiro login de cada usuário.
USER_CYPHER_SECRET_KEY=
